config_version=5

[application]

config/name="Keystroked"
run/main_scene="res://scenes/menus/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://autoload/GameState.gd"
Conductor="*res://autoload/Conductor.gd"

[display]

